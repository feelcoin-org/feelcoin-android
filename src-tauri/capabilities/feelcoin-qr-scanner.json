{
  "identifier": "feelcoin-qr-scanner",
  "description": "Enable QR camera scanning for the Android wallet only",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "barcode-scanner:allow-scan",
    "barcode-scanner:allow-check-permissions",
    "barcode-scanner:allow-request-permissions",
    "barcode-scanner:allow-cancel"
  ]
}
